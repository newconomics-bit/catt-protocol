# CATT Protocol — Release keystore configuration (TEMPLATE ONLY)
# 
# COPY this file to android/keystore.properties and fill in real values.
# keystore.properties MUST NEVER BE COMMITTED (listed in android/.gitignore).
#
# The keystore file (release.keystore) must also be kept OUTSIDE the repository.
# Recommended location: android/keystore/release.keystore (also gitignored).
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore android/keystore/release.keystore \
#     -alias release -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD -keypass YOUR_KEY_PASSWORD
#
# Then fill in the values below:
storeFile=../keystore/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=release
keyPassword=YOUR_KEY_PASSWORD