# SECURITY: .env must never be committed. Copy this file to .env and fill in real values locally.
# .env is listed in .gitignore — keep it that way.

# Polygon Amoy testnet RPC endpoint (e.g. an Infura/Alchemy/QuickNode HTTPS URL for chain id 80002)
POLYGON_RPC_URL=

# Deployer private key(s). Comma-separated for multiple keys. NEVER commit real keys.
# The first key is used as the deployer. MUST be funded with Amoy MATIC for gas.
PRIVATE_KEY=

# Polygonscan API key for contract verification (optional)
POLYGONSCAN_API_KEY=

# Backend Judge address -> MiningClaimer.signer. MUST be a real, non-zero address.
# This is the address whose EIP-712 signatures the MiningClaimer will accept.
SIGNER_ADDRESS=

# Team vesting beneficiary: receives 15,000,000 CATT (vested via TeamVesting).
TEAM_BENEFICIARY=

# Treasury beneficiary: receives 20,000,000 CATT (vested via TeamVesting).
# MUST differ from TEAM_BENEFICIARY (TeamVesting reverts on duplicate).
TREASURY_BENEFICIARY=

# Marketing wallet: receives 15,000,000 CATT (marketing bucket, NOT liquidity).
# REQUIRED — no default. Must be a distinct destination.
MARKETING_WALLET=

# DEX liquidity wallet: receives 10,000,000 CATT (liquidity bucket).
# Optional; defaults to deployer with a loud warning if unset.
LIQUIDITY_WALLET=

# Yield token for BondManager (real stablecoin address on Amoy).
# Required unless using --mock-yield / MOCK_YIELD=true.
YIELD_TOKEN_ADDRESS=

# Optional: override the genesis mint total (must equal 60,000,000 CATT derived from buckets)
# INITIAL_SUPPLY=60000000

# Optional: deployment output path (default: smart-contracts/deployed-testnet.json)
# DEPLOYMENT_OUTPUT=

# Optional: expected chain id (default: 80002 for Polygon Amoy)
# EXPECTED_CHAIN_ID=80002

# Optional: use test mock yield token (MockUSDT) instead of real stablecoin
# MOCK_YIELD=true

# Optional: force overwrite existing deployment manifest
# FORCE=true

# Optional: dry run (deploy and verify, but don't write manifest)
# DRY_RUN=true
