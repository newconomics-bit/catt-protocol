# SECURITY: .env must never be committed. Copy this file to .env and fill in real values locally.
# .env is listed in .gitignore — keep it that way.

# Polygon RPC endpoint (e.g. an Infura/Alchemy/QuickNode HTTPS URL)
POLYGON_RPC_URL=

# Deployer private key(s). Comma-separated for multiple keys. NEVER commit real keys.
PRIVATE_KEY=

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=
