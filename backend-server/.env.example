# CATT Protocol backend environment — TEMPLATE ONLY.
# Copy to `.env` and fill in locally. `.env` must NEVER be committed.

# Private key of the backend signer (the address allowed by MiningClaimer).
# READ BY backend-server/signer.js. NEVER commit this value, never log it.
# 32-byte hex private key, e.g. 0x followed by 64 hex characters.
SIGNER_PRIVATE_KEY=

# EVM chain id used as the EIP-712 domain separator (e.g. 11155111 for Sepolia).
# ALSO used as the domain of every digest the gasless relay rebuilds, so a
# mismatch here would make relayed claims unverifiable on-chain.
CHAIN_ID=

# Address of the deployed MiningClaimer contract.
# Used as `verifyingContract` in the EIP-712 domain.
MINING_CLAIMER_ADDRESS=

# ---------------------------------------------------------------------------
# Storage adapter (optional)
# ---------------------------------------------------------------------------
# Which implementation of the storage interface (backend-server/src/storage.js)
# the Judge should use. Both are drop-in: same methods, same semantics.
#
#   (unset) or "memory"  in-memory Maps. The default, and what the test suite
#                        uses. VOLATILE: sessions, telemetry, submissions,
#                        reserved nonces, issued claims and relay records are
#                        all lost when the process restarts, which means a
#                        restart re-issues nonces that were already handed out.
#                        Acceptable for a demo, not for anything paying out.
#   "sqlite"             a single SQLite file (backend-server/src/sqlite-store.js)
#                        that survives a restart, with the nonce-uniqueness and
#                        relay-once invariants additionally enforced by the
#                        schema. Single-node / testnet persistence; Postgres
#                        remains the production target.
#
# An unrecognised value is a STARTUP ERROR, not a silent fallback to memory.
CATT_STORE=

# Database file used ONLY when CATT_STORE=sqlite. Leave empty to take the
# adapter's documented default, which is OUTSIDE this repository working tree
# (/var/lib/catt-judge/judge.db) precisely so it cannot be committed by
# accident. A relative path is resolved against the process working directory.
#
# THE DATABASE FILE MUST NEVER BE COMMITTED. It contains live session ids,
# wallet addresses, mined telemetry, signed EIP-712 claims and their
# signatures — a signature IS a bearer token for that reward until its deadline,
# so a committed `.db` is a committed payout. If you point this inside a repo
# or deployment tree, gitignore it there yourself. The `-wal` and `-shm`
# sidecar files belong next to it and are equally sensitive.
SQLITE_PATH=

# ---------------------------------------------------------------------------
# Gasless relay (optional — PRD 3.2 "Gasless transaction")
# ---------------------------------------------------------------------------
# With the relay configured, the mobile app posts a Judge-issued claim to
# `POST /api/relay` and the BACKEND pays the gas, so the user never needs
# MATIC. Without these two values the endpoint answers
# `503 RELAY_NOT_CONFIGURED` and the app falls back to submitting the
# transaction itself — the relay is optional, the Judge is not.

# JSON-RPC endpoint used ONLY to broadcast relayed claims.
# Leave empty on a dev box to run without the relay.
RPC_URL=

# Private key of the RELAYER (the gas sponsor), kept SEPARATE from
# SIGNER_PRIVATE_KEY above: the signer attests to mining rewards, the relayer
# only pays gas. A relayer key never signs anything, so compromising it cannot
# forge a claim — but it can still drain its own balance, so treat it as a
# hot wallet and fund it for gas only.
# READ BY backend-server/src/relay.js. NEVER commit this value, NEVER log it,
# and never return it from any endpoint: `GET /api/relay/status` publishes the
# relayer's public ADDRESS only.
RELAYER_PRIVATE_KEY=

# ===========================================================================
# THE LIVE ECONOMY (optional — every flag below is ON by default)
# ===========================================================================
# READ BY backend-server/src/server.js (`readEconomyConfig`), for non-secret
# configuration only. Every mechanism here is LIVE unless you explicitly turn it
# off, and the parse rule is deliberately INVERTED relative to the usual
# "safe defaults" convention. THIS IS THE FOUNDER'S CHOICE — DO NOT "FIX" IT:
#
#     ONLY AN EXPLICIT LITERAL `false`, `0` OR `off` DISABLES A MECHANISM.
#
# Unset, empty, whitespace, a typo, `yes`, `1`, `true`, `enabled` — ALL of them
# leave the AGGRESSIVE behaviour ON. A misspelled `CATT_DYNAMIC_EMISSION=false`
# does NOT quietly restore flat rewards: it leaves dynamic emission running,
# which is loud and observable, rather than silently reverting to an economics
# policy nobody chose.
#
# ---------------------------------------------------------------------------
# Dynamic emission — rewards shrink as the daily active-miner count grows.
# ---------------------------------------------------------------------------
# Rewards are the authored mission base scaled by a factor in [5000, 10000] bps:
# exactly 1.0x at or below CATT_DYNAMIC_EMISSION_TRIGGER_MINERS (5,000) miners,
# decaying to 0.5x at CATT_DYNAMIC_EMISSION_FLOOR_MINERS (50,000), and flat at
# 0.5x above that. The threshold and the floor are frozen in
# backend-server/src/economics.js and are NOT configuration.
#
#   (unset) or anything but false/0/off  dynamic emission ON (the founder's value)
#   "false" / "0" / "off"                  OFF: every mission pays its flat base
CATT_DYNAMIC_EMISSION=

# Top of the dynamic-emission ramp, in ACTIVE MINERS. Default 50000.
# A non-numeric value falls back to the default rather than becoming a different
# economic parameter.
CATT_DYNAMIC_EMISSION_FLOOR_MINERS=

# ---------------------------------------------------------------------------
# Streak multiplier — consecutive graded days raise the reward.
# ---------------------------------------------------------------------------
# +0.2x per already-banked consecutive graded UTC day, 1.0x to 2.0x, clamped.
# The streak is READ before the completion is recorded, and recorded only on an
# actual PASS, so two missions in one UTC day cannot farm a bonus day.
#
#   (unset) or anything but false/0/off  streak pricing ON (the founder's value)
#   "false" / "0" / "off"                  OFF: the flat base, every day. The day
#                                          ledger still advances, so re-enabling
#                                          the flag pays the real ladder.
CATT_STREAK_MULTIPLIER=

# ---------------------------------------------------------------------------
# Seasons — twenty contiguous 30-day windows, 2,000,000 CATT each.
# ---------------------------------------------------------------------------
# The pool is a HARD CAP. When a season is spent, every claim fails loudly with
# `409 SEASON_ALLOCATION_EXHAUSTED`: no mint, no signature, no nonce reserved, no
# success response. An instant before the epoch — or one no window covers — is
# `409 SEASON_NO_ACTIVE_SEASON`, with NO fallback season.
#
#   (unset) or anything but false/0/off  the 20-season schedule is written on
#                                          boot and settled per claim
#   "false" / "0" / "off"                  OFF: an uncapped pool, no schedule
CATT_SEASONS=

# Launch instant the twenty windows are generated from, in UNIX SECONDS.
# UNSET means "the moment this Judge booted" (season 1 starts now), because the
# schedule is contiguous 30-day windows from the epoch and the founder's
# documented default of 0 would place every window inside 1970 — after which
# every claim would refuse loudly with SEASON_NO_ACTIVE_SEASON and the Judge
# would sign nothing, ever. Set it to 0 explicitly and that behaviour is exactly
# what you get. Any non-numeric value falls back to the boot instant.
CATT_SEASON_EPOCH=

# ---------------------------------------------------------------------------
# Free stamina — 30 points per user per UTC day, off-chain ledger only.
# ---------------------------------------------------------------------------
# Granted once per (user, UTC day), recorded by the Judge as an allowance the
# user is OWED. It NEVER bypasses the on-chain `consumeStamina`: the claim still
# has to settle against `StakingManager` or it reverts there. Nothing here mints,
# credits a balance or weakens a check.
#
#   (unset) or anything but false/0/off  the daily grant ON (the founder's value)
#   "false" / "0" / "off"                  OFF: nothing is granted
CATT_FREE_STAMINA=

# ---------------------------------------------------------------------------
# Daily stamina SPEND ceiling, in unitless points. Default 50.
# ---------------------------------------------------------------------------
# A cap on stamina SPENT per UTC day, re-derived from the per-DAY ledger, so
# unspent stamina rolls over and is never confiscated. It is enforced ALONGSIDE
# the free grant above, which buys access to the day's first missions rather than
# a way past the day's ceiling. A refusal is a loud `429
# DAILY_STAMINA_CAP_EXCEEDED` raised BEFORE the nonce is reserved, so a throttled
# user has burned nothing. A non-numeric value falls back to 50.
CATT_DAILY_STAMINA_CAP=